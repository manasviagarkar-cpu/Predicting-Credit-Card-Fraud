te_input":"2026-11-08T07:24:47.639659Z","iopub.status.idle":"2026-11-08T07:24:50.023965Z","shell.execute_reply.started":"2026-11-08T07:24:47.639601Z","shell.execute_reply":"2026-11-08T07:24:50.023032Z"}},"outputs":[{"name":"stdout","text":"/kaggle/input/competitions/playground-series-s6e11/sample_submission.csv\n/kaggle/input/competitions/playground-series-s6e11/train.csv\n/kaggle/input/competitions/playground-series-s6e11/test.csv\n","output_type":"stream"}],"execution_count":1},{"cell_type":"code","source":"\"\"\"\nPlayground Series S6E11 - Predicting Credit Card Fraud\n\nKaggle input path:\n    /kaggle/input/competitions/playground-series-s6e11/\n\nLocal usage:\n    python solution.py --data-dir /path/to/extracted/playground-series-s6e11\n\nThe metric is ROC-AUC, so submit continuous probabilities, not 0/1 labels.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport os\nimport warnings\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\nfrom lightgbm import LGBMClassifier, early_stopping, log_evaluation\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import roc_auc_score\n\nwarnings.filterwarnings(\"ignore\")\n\nTARGET = \"is_fraud\"\nCAT_COLS = [\n    \"merchant_category\", \"card_type\", \"auth_method\", \"channel\", \"device_type\"\n]\nBOOL_COLS = [\n    \"is_foreign_transaction\", \"is_new_merchant\", \"used_vpn\",\n    \"ip_country_mismatch\", \"billing_shipping_mismatch\",\n    \"is_ai_generated_scam_attempt\"\n]\n\n\ndef feature_engineer(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"Create only train/test-available features; no target or row-label leakage.\"\"\"\n    x = df.copy()\n\n    # Treat booleans as numeric indicators.\n    for c in BOOL_COLS:\n        if c in x.columns:\n            x[c] = x[c].astype(np.int8)\n\n    # Strong, interpretable fraud-risk combinations.\n    flag_cols = [c for c in BOOL_COLS if c in x.columns]\n    x[\"risk_flag_count\"] = x[flag_cols].sum(axis=1).astype(np.int8)\n    x[\"identity_mismatch_count\"] = (\n        x[\"ip_country_mismatch\"] + x[\"billing_shipping_mismatch\"]\n    ).astype(np.int8)\n    x[\"security_alert_count\"] = (\n        x[\"used_vpn\"] + x[\"is_new_merchant\"] + x[\"is_ai_generated_scam_attempt\"]\n    ).astype(np.int8)\n\n    # Smooth transforms and ratios. Small epsilons avoid division by zero.\n    x[\"log_amount\"] = np.log1p(x[\"amount_usd\"].clip(lower=0))\n    x[\"log_balance\"] = np.log1p(x[\"account_balance_usd\"].clip(lower=0))\n    x[\"amount_balance_ratio\"] = x[\"amount_usd\"] / (x[\"account_balance_usd\"] + 10.0)\n    x[\"amount_per_card_month\"] = x[\"amount_usd\"] / (x[\"card_age_months\"] + 1.0)\n    x[\"velocity_risk_interaction\"] = x[\"velocity_score\"] * x[\"merchant_risk_score\"]\n    x[\"velocity_per_txn\"] = x[\"velocity_score\"] / (x[\"txn_count_last_24h\"] + 1.0)\n    x[\"txn_frequency\"] = x[\"txn_count_last_24h\"] / (x[\"hours_since_last_txn\"] + 1.0)\n    x[\"age_card_ratio\"] = x[\"customer_age\"] / (x[\"card_age_months\"] + 1.0)\n\n    # Cyclic time encodings.\n    x[\"hour_sin\"] = np.sin(2 * np.pi * x[\"time_of_day_hour\"] / 24.0)\n    x[\"hour_cos\"] = np.cos(2 * np.pi * x[\"time_of_day_hour\"] / 24.0)\n    x[\"dow_sin\"] = np.sin(2 * np.pi * x[\"day_of_week\"] / 7.0)\n    x[\"dow_cos\"] = np.cos(2 * np.pi * x[\"day_of_week\"] / 7.0)\n\n    # ID is just the row identifier and is not a causal feature.\n    x = x.drop(columns=[\"id\"], errors=\"ignore\")\n    return x\n\n\ndef prepare(train: pd.DataFrame, test: pd.DataFrame):\n    y = train.pop(TARGET).astype(np.int8)\n    all_x = pd.concat([train, test], axis=0, ignore_index=True)\n    all_x = feature_engineer(all_x)\n\n    # Concatenating before one-hot encoding guarantees identical columns.\n    cats = [c for c in CAT_COLS if c in all_x.columns]\n    all_x = pd.get_dummies(all_x, columns=cats, dtype=np.float32)\n    all_x = all_x.replace([np.inf, -np.inf], np.nan).fillna(0)\n    all_x = all_x.astype(np.float32)\n    x_train = all_x.iloc[: len(train)].reset_index(drop=True)\n    x_test = all_x.iloc[len(train):].reset_index(drop=True)\n    return x_train, y.reset_index(drop=True), x_test\n\n\ndef make_model(seed: int, n_estimators: int) -> LGBMClassifier:\n    return LGBMClassifier(\n        objective=\"binary\",\n        n_estimators=n_estimators,\n        learning_rate=0.030,\n        num_leaves=31,\n        max_depth=-1,\n        min_child_samples=80,\n        subsample=0.88,\n        subsample_freq=1,\n        colsample_bytree=0.90,\n        reg_alpha=0.05,\n        reg_lambda=3.0,\n        random_state=seed,\n        n_jobs=-1,\n        verbosity=-1,\n    )\n\n\ndef main(data_dir: str, output: str, validate: bool, seeds: list[int], external_csv: str | None):\n    data = Path(data_dir)\n    train = pd.read_csv(data / \"train.csv\")\n    test = pd.read_csv(data / \"test.csv\")\n    sample = pd.read_csv(data / \"sample_submission.csv\")\n    test_ids = test[\"id\"].copy()\n\n    # Optional public source data. Use only if you have added it as a Kaggle input.\n    if external_csv:\n        ext = pd.read_csv(external_csv)\n        if \"transaction_id\" in ext.columns and \"id\" not in ext.columns:\n            ext = ext.rename(columns={\"transaction_id\": \"id\"})\n        if set(train.columns).issubset(ext.columns):\n            ext = ext[list(train.columns)]\n            train = pd.concat([train, ext], ignore_index=True)\n            print(f\"added external rows: {len(ext)}\")\n        else:\n            print(\"external file ignored because its columns do not match train.csv\")\n\n    X, y, Xt = prepare(train, test)\n    print(f\"train={X.shape}, test={Xt.shape}, positive_rate={y.mean():.6f}\")\n\n    # One fixed holdout is only used to select a conservative tree count.\n    n_estimators = 1100\n    if validate:\n        tr_idx, va_idx = train_test_split(\n            np.arange(len(y)), test_size=0.20, random_state=42, stratify=y\n        )\n        probe = make_model(42, 3000)\n        probe.fit(\n            X.iloc[tr_idx], y.iloc[tr_idx],\n            eval_set=[(X.iloc[va_idx], y.iloc[va_idx])],\n            callbacks=[early_stopping(100, verbose=False), log_evaluation(0)],\n        )\n        n_estimators = max(100, int(probe.best_iteration_ + 1))\n        va_pred = probe.predict_proba(X.iloc[va_idx])[:, 1]\n        print(f\"holdout ROC-AUC={roc_auc_score(y.iloc[va_idx], va_pred):.6f}\")\n        print(f\"selected n_estimators={n_estimators}\")\n\n    # Seed averaging improves ranking stability. No target-derived feature is used.\n    pred = np.zeros(len(Xt), dtype=np.float64)\n    for seed in seeds:\n        print(f\"training seed={seed}, trees={n_estimators}\")\n        model = make_model(seed, n_estimators)\n        model.fit(X, y, callbacks=[log_evaluation(0)])\n        pred += model.predict_proba(Xt)[:, 1] / len(seeds)\n\n    # Preserve sample-submission/test order exactly.\n    submission = pd.DataFrame({\"id\": test_ids, TARGET: pred})\n    if len(sample) == len(submission) and list(sample.columns) == [\"id\", TARGET]:\n        submission = submission[[\"id\", TARGET]]\n    submission.to_csv(output, index=False)\n    print(f\"wrote {output} with shape={submission.shape}\")\n    print(submission.head())\n\n\nif __name__ == \"__main__\":\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\n        \"--data-dir\", default=\"/kaggle/input/competitions/playground-series-s6e11\",\n        help=\"folder containing train.csv, test.csv, sample_submission.csv\",\n    )\n    ap.add_argument(\"--output\", default=\"submission.csv\")\n    ap.add_argument(\"--validate\", action=\"store_true\", help=\"run holdout and select tree count\")\n    ap.add_argument(\"--seeds\", nargs=\"+\", type=int, default=[42, 2026, 3407])\n    ap.add_argument(\"--external-csv\", default=None, help=\"optional public labeled source CSV\")\n    # Kaggle/Jupyter may inject arguments such as:\n    # -f /root/.local/share/jupyter/runtime/kernel-....json\n    # Ignore those notebook-internal arguments when this file is run in a cell.\n    args, _unknown = ap.parse_known_args()\n    main(args.data_dir, args.output, args.validate, args.seeds, args.external_csv)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-08T07:25:01.987021Z","iopub.execute_input":"2026-11-08T07:25:01.987851Z","iopub.status.idle":"2026-11-08T07:28:10.011334Z","shell.execute_reply.started":"2026-11-08T07:25:01.987815Z","shell.execute_reply":"2026-11-08T07:28:10.010385Z"}},"outputs":[{"name":"stdout","text":"train=(699960, 69), test=(299984, 69), positive_rate=0.016700\ntraining seed=42, trees=1100\ntraining seed=2026, trees=1100\ntraining seed=3407, trees=1100\nwrote submission.csv with shape=(299984, 2)\n       id  is_fraud\n0  699960  0.000235\n1  699961  0.000111\n2  699962  0.069282\n3  699963  0.001393\n4  699964  0.001193\n","output_type":"stream"}],"execution_count":2}]}