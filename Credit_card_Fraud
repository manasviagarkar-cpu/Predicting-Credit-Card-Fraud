"""
Playground Series S6E11 - Predicting Credit Card Fraud

Kaggle input path:
    /kaggle/input/competitions/playground-series-s6e11/

Local usage:
    python solution.py --data-dir /path/to/extracted/playground-series-s6e11

The metric is ROC-AUC, so submit continuous probabilities, not 0/1 labels.
"""
from __future__ import annotations

import argparse
import os
import warnings
from pathlib import Path

import numpy as np
import pandas as pd
from lightgbm import LGBMClassifier, early_stopping, log_evaluation
from sklearn.model_selection import train_test_split
from sklearn.metrics import roc_auc_score

warnings.filterwarnings("ignore")

TARGET = "is_fraud"
CAT_COLS = [
    "merchant_category", "card_type", "auth_method", "channel", "device_type"
]
BOOL_COLS = [
    "is_foreign_transaction", "is_new_merchant", "used_vpn",
    "ip_country_mismatch", "billing_shipping_mismatch",
    "is_ai_generated_scam_attempt"
]


def feature_engineer(df: pd.DataFrame) -> pd.DataFrame:
    """Create only train/test-available features; no target or row-label leakage."""
    x = df.copy()

    # Treat booleans as numeric indicators.
    for c in BOOL_COLS:
        if c in x.columns:
            x[c] = x[c].astype(np.int8)

    # Strong, interpretable fraud-risk combinations.
    flag_cols = [c for c in BOOL_COLS if c in x.columns]
    x["risk_flag_count"] = x[flag_cols].sum(axis=1).astype(np.int8)
    x["identity_mismatch_count"] = (
        x["ip_country_mismatch"] + x["billing_shipping_mismatch"]
    ).astype(np.int8)
    x["security_alert_count"] = (
        x["used_vpn"] + x["is_new_merchant"] + x["is_ai_generated_scam_attempt"]
    ).astype(np.int8)

    # Smooth transforms and ratios. Small epsilons avoid division by zero.
    x["log_amount"] = np.log1p(x["amount_usd"].clip(lower=0))
    x["log_balance"] = np.log1p(x["account_balance_usd"].clip(lower=0))
    x["amount_balance_ratio"] = x["amount_usd"] / (x["account_balance_usd"] + 10.0)
    x["amount_per_card_month"] = x["amount_usd"] / (x["card_age_months"] + 1.0)
    x["velocity_risk_interaction"] = x["velocity_score"] * x["merchant_risk_score"]
    x["velocity_per_txn"] = x["velocity_score"] / (x["txn_count_last_24h"] + 1.0)
    x["txn_frequency"] = x["txn_count_last_24h"] / (x["hours_since_last_txn"] + 1.0)
    x["age_card_ratio"] = x["customer_age"] / (x["card_age_months"] + 1.0)

    # Cyclic time encodings.
    x["hour_sin"] = np.sin(2 * np.pi * x["time_of_day_hour"] / 24.0)
    x["hour_cos"] = np.cos(2 * np.pi * x["time_of_day_hour"] / 24.0)
    x["dow_sin"] = np.sin(2 * np.pi * x["day_of_week"] / 7.0)
    x["dow_cos"] = np.cos(2 * np.pi * x["day_of_week"] / 7.0)

    # ID is just the row identifier and is not a causal feature.
    x = x.drop(columns=["id"], errors="ignore")
    return x


def prepare(train: pd.DataFrame, test: pd.DataFrame):
    y = train.pop(TARGET).astype(np.int8)
    all_x = pd.concat([train, test], axis=0, ignore_index=True)
    all_x = feature_engineer(all_x)

    # Concatenating before one-hot encoding guarantees identical columns.
    cats = [c for c in CAT_COLS if c in all_x.columns]
    all_x = pd.get_dummies(all_x, columns=cats, dtype=np.float32)
    all_x = all_x.replace([np.inf, -np.inf], np.nan).fillna(0)
    all_x = all_x.astype(np.float32)
    x_train = all_x.iloc[: len(train)].reset_index(drop=True)
    x_test = all_x.iloc[len(train):].reset_index(drop=True)
    return x_train, y.reset_index(drop=True), x_test


def make_model(seed: int, n_estimators: int) -> LGBMClassifier:
    return LGBMClassifier(
        objective="binary",
        n_estimators=n_estimators,
        learning_rate=0.030,
        num_leaves=31,
        max_depth=-1,
        min_child_samples=80,
        subsample=0.88,
        subsample_freq=1,
        colsample_bytree=0.90,
        reg_alpha=0.05,
        reg_lambda=3.0,
        random_state=seed,
        n_jobs=-1,
        verbosity=-1,
    )


def main(data_dir: str, output: str, validate: bool, seeds: list[int], external_csv: str | None):
    data = Path(data_dir)
    train = pd.read_csv(data / "train.csv")
    test = pd.read_csv(data / "test.csv")
    sample = pd.read_csv(data / "sample_submission.csv")
    test_ids = test["id"].copy()

    # Optional public source data. Use only if you have added it as a Kaggle input.
    if external_csv:
        ext = pd.read_csv(external_csv)
        if "transaction_id" in ext.columns and "id" not in ext.columns:
            ext = ext.rename(columns={"transaction_id": "id"})
        if set(train.columns).issubset(ext.columns):
            ext = ext[list(train.columns)]
            train = pd.concat([train, ext], ignore_index=True)
            print(f"added external rows: {len(ext)}")
        else:
            print("external file ignored because its columns do not match train.csv")

    X, y, Xt = prepare(train, test)
    print(f"train={X.shape}, test={Xt.shape}, positive_rate={y.mean():.6f}")

    # One fixed holdout is only used to select a conservative tree count.
    n_estimators = 1100
    if validate:
        tr_idx, va_idx = train_test_split(
            np.arange(len(y)), test_size=0.20, random_state=42, stratify=y
        )
        probe = make_model(42, 3000)
        probe.fit(
            X.iloc[tr_idx], y.iloc[tr_idx],
            eval_set=[(X.iloc[va_idx], y.iloc[va_idx])],
            callbacks=[early_stopping(100, verbose=False), log_evaluation(0)],
        )
        n_estimators = max(100, int(probe.best_iteration_ + 1))
        va_pred = probe.predict_proba(X.iloc[va_idx])[:, 1]
        print(f"holdout ROC-AUC={roc_auc_score(y.iloc[va_idx], va_pred):.6f}")
        print(f"selected n_estimators={n_estimators}")

    # Seed averaging improves ranking stability. No target-derived feature is used.
    pred = np.zeros(len(Xt), dtype=np.float64)
    for seed in seeds:
        print(f"training seed={seed}, trees={n_estimators}")
        model = make_model(seed, n_estimators)
        model.fit(X, y, callbacks=[log_evaluation(0)])
        pred += model.predict_proba(Xt)[:, 1] / len(seeds)

    # Preserve sample-submission/test order exactly.
    submission = pd.DataFrame({"id": test_ids, TARGET: pred})
    if len(sample) == len(submission) and list(sample.columns) == ["id", TARGET]:
        submission = submission[["id", TARGET]]
    submission.to_csv(output, index=False)
    print(f"wrote {output} with shape={submission.shape}")
    print(submission.head())


if __name__ == "__main__":
    ap = argparse.ArgumentParser()
    ap.add_argument(
        "--data-dir", default="/kaggle/input/competitions/playground-series-s6e11",
        help="folder containing train.csv, test.csv, sample_submission.csv",
    )
    ap.add_argument("--output", default="submission.csv")
    ap.add_argument("--validate", action="store_true", help="run holdout and select tree count")
    ap.add_argument("--seeds", nargs="+", type=int, default=[42, 2026, 3407])
    ap.add_argument("--external-csv", default=None, help="optional public labeled source CSV")
    # Kaggle/Jupyter may inject arguments such as:
    # -f /root/.local/share/jupyter/runtime/kernel-....json
    # Ignore those notebook-internal arguments when this file is run in a cell.
    args, _unknown = ap.parse_known_args()
    main(args.data_dir, args.output, args.validate, args.seeds, args.external_csv)

